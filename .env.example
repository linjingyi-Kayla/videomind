# ========== 必填 ==========
# DeepSeek（总结 / 分类）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# RapidAPI YouTube 字幕（youtube-transcript3）
RAPIDAPI_KEY=
RAPIDAPI_ENDPOINT=https://youtube-transcript3.p.rapidapi.com/api/transcript
RAPIDAPI_HOST=youtube-transcript3.p.rapidapi.com

# ========== 数据库 ==========
# 本地默认 SQLite
VIDEOMIND_DB_PATH=data/videomind.sqlite3
# 生产优先使用 DATABASE_URL（如 Railway Postgres）
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ========== Web Push（可选）==========
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:you@example.com

# ========== 其它可选 ==========
# 生产 HTTPS 下登录 Cookie 加 Secure
# COOKIE_SECURE=1

# JWT 签名密钥（不设则使用内置默认，生产务必自建）
# VIDEOMIND_JWT_SECRET=

# 轻量 Web Search（问视频 Agent 事实核查 / 最新情况；不配则该工具返回 web_search_not_configured）
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_API_KEY=
# 可选 provider：tavily | brave | serper

# 旧数据迁移到默认用户（仅特殊迁移场景）
# VIDEOMIND_LEGACY_EMAIL=
# VIDEOMIND_LEGACY_PASSWORD=

# AI 提醒时间默认时区偏移（与 Date.getTimezoneOffset 一致，东八区多为 -480）
# VIDEOMIND_DEFAULT_TZ_OFFSET=-480

# 仅在需要从「旧 tasks 表（无 task_uuid）」迁移时设为 1
# VIDEOMIND_ALLOW_LEGACY_TASKS_MIGRATION=1
